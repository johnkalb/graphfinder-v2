<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Weekly relation_type hygiene audit (audit_relation_types.py). Read-only, streams the relationships table, flags relation_type values with digits/parenthesized free text baked in and reports OTHER-bucket share per source_data -- the periodic check that catches a harvester silently mis-scoring data (found and fixed 4 such bugs 2026-08-29/31: FEC amount-embedded, IRS POSITION() wrapper, PATENT_COINVENTOR CO_INVENTOR_WITH/INVENTOR_AT, RECONCILIATION CROSS_REFERENCED) before it goes unnoticed for months again. Output goes to the log file only, not email -- no local harvester has SMTP configured.</Description>
    <URI>\sixdegrees\relation-type-audit</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-3672366836-2251323244-2258749295-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-09-06T06:15:00-04:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
