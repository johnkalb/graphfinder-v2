      <Command>wscript.exe</Command>
      <Arguments>//B //NoLogo "C:\Users\johnk\AppData\Local\hermes\scripts\run_hidden.vbs" "C:\Users\johnk\AppData\Local\hermes\scripts\sixdegrees_task_logs\relation-type-audit.log" "C:\Users\johnk\venv\Scripts\python.exe" "C:\Users\johnk\desktop\sixdegrees\audit_relation_types.py"</Arguments>
      <WorkingDirectory>C:\Users\johnk\desktop\sixdegrees</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
